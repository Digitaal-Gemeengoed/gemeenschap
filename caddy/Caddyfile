# Het gemeenschapsplatform. Caddy haalt zelf certificaten op voor alle namen.
# Nodig in DNS: A-records (of CNAME's) naar deze server voor <domein>,
# www.<domein>, aanmelden.<domein>, en de subdomeinen van de modules die aan
# staan (server/controleer.sh noemt ze).

# Logo en icoon van de organisatie (huisstijl/ in de repo) op elk adres onder
# /huisstijl/, zodat elke module ze met een vast pad kan tonen.
# kleuren.css: de kleuren uit organisatie.yml als CSS-variabelen
# (--dg-kleur, --dg-kleur-donker, --dg-kleur-link, --dg-accent, --dg-accent-donker).
(huisstijl) {
	handle_path /huisstijl/* {
		@kleuren path /kleuren.css
		header @kleuren Content-Type "text/css; charset=utf-8"
		respond @kleuren ":root{--dg-kleur:{$ORG_KLEUR:#14478f};--dg-kleur-donker:{$ORG_KLEUR_DONKER:#0a2654};--dg-kleur-link:{$ORG_KLEUR_LINK:#1a56a8};--dg-accent:{$ORG_ACCENT:#0066cc};--dg-accent-donker:{$ORG_ACCENT_DONKER:#003c7a}}" 200
		root * /srv/huisstijl
		file_server
	}
}

(beveiliging) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$DOMEIN} {
	import beveiliging
	import huisstijl
	encode zstd gzip
	# XML-RPC is een bekend doelwit en hier niet nodig.
	@xmlrpc path /xmlrpc.php
	respond @xmlrpc 404
	# Wie WordPress-gebruikers opsomt via de REST-API, krijgt niets (ledenlijsten alleen ingelogd, in BuddyPress).
	@gebruikers path /wp-json/wp/v2/users*
	respond @gebruikers 404
	# Het berichteneindpunt van Documenten (/wp-json/dg/...) is alleen voor binnen het
	# Docker-netwerk. Het geheim is de echte slot; dit is de tweede.
	@intern expression `{path}.matches("(?i)^/+wp-json/+dg/") || {query.rest_route}.matches("(?i)^/*dg/")`
	respond @intern 404
	# Wat modules op het hoofddomein nodig hebben (caddy/modules/*.hoofd.caddy).
	import /etc/caddy-actief/hoofd/*.caddy
	reverse_proxy wordpress:80
}

www.{$DOMEIN} {
	redir https://{$DOMEIN}{uri} permanent
}

aanmelden.{$DOMEIN} {
	import beveiliging
	import huisstijl
	# Het beheerscherm van Keycloak niet naar buiten; via de SSH-tunnel (README.md, Beheer op de server).
	@beheer path /admin*
	respond @beheer "Niet beschikbaar" 404
	@root path /
	redir @root https://{$DOMEIN}/ 302
	reverse_proxy keycloak:8080
}

# --- Modules --------------------------------------------------------------------
# De subdomeinen van de modules die aan staan (caddy/modules/, gekopieerd door
# server/bijwerken.sh naar /etc/caddy-actief/).
import /etc/caddy-actief/*.caddy
